# Lokal demo. Jika database volume versi lama sudah ada, gunakan password yang sama seperti volume sebelumnya.
# Ganti password SEBELUM pertama kali membuat volume PostgreSQL baru untuk penggunaan lain.
POSTGRES_PASSWORD=change-me-local-only
# Impor tidak aktif secara default. Jangan aktifkan pada deployment publik tanpa autentikasi sesungguhnya.
ENABLE_IMPORT=false
IMPORT_TOKEN=

# Tampilkan DATA AKTUAL (data/private/incoming) di dashboard. Default false = hanya ringkasan terbatas.
# Aktifkan HANYA di komputer lokal tim. Sebelum aplikasi online, wajib AUTH_MODE=token (lihat deploy/production.env.example).
ALLOW_ACTUAL_DATA_VIEW=false
